# /etc/cwfr-fuzz.env -- read by cwfr-fuzz.service.

# The checkout of the core (backend/core of the site, or the core repository);
# pull it before the run however the server does that, e.g. a git pull in a
# systemd ExecStartPre= of your own.
CWFR_CORE=/srv/cwfr/backend/core

# Build trees, results and grown corpora; must persist between runs.
CI_BUILD_DIR=/var/lib/cwfr-fuzz

# Time per target and parallelism.
FUZZ_SECONDS=3600
#FUZZ_JOBS=8

# Where a failure goes; the report arrives on stdin.
FUZZ_NOTIFY_COMMAND=logger -t cwfr-fuzz
#FUZZ_NOTIFY_COMMAND=mail -s "cwfr fuzzing failed" dev@example.com
