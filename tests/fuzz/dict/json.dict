# Структурные знаки и литералы JSON (RFC 8259).
obj_open="{"
obj_close="}"
arr_open="["
arr_close="]"
colon=":"
comma=","
quote="\""
true="true"
false="false"
null="null"
esc_quote="\\\""
esc_back="\\\\"
esc_u="\\u"
surrogate_hi="\\ud800"
surrogate_lo="\\udc00"
exp="e+"
neg_exp="e-"
